# ──────────────────────────────────────────────────────────────────────
# Backend env template. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────────────

# Claude / Anthropic — powers /api/report summaries (blank = template fallback)
ANTHROPIC_API_KEY=

# Cyvl Data API — run `python cyvl_oauth.py` to populate these via browser login
CYVL_API_KEY=
CYVL_REFRESH_TOKEN=
CYVL_CLIENT_ID=
CYVL_PROJECT_ID=f15b854a-d203-49c7-bc25-1350dd4a1cd6
CYVL_BASE=https://i3.cyvl.app

# Autodesk Platform Services — register an app at https://aps.autodesk.com
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET_KEY=walkability-tool-bucket

# Google Maps Directions API (enable "Directions API" for the key)
GOOGLE_MAPS_KEY=
