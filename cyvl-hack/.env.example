# Frontend env template (Create React App). Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored — never commit real tokens.

# Mapbox token for the map + geocoding autocomplete (https://account.mapbox.com)
REACT_APP_MAPBOX_TOKEN=

# Backend API base URL (defaults to http://localhost:8000 if unset)
REACT_APP_API_BASE_URL=http://localhost:8000
